# ------------------------------------------------------------
# TEMPLATE / FRONTEND ASSETS
# ------------------------------------------------------------

# Public assets tetap diizinkan masuk Git
!/public/assets
!/public/assets/*


# Vendor fonts yang tidak perlu di-track
/resources/assets/vendor/fonts/flags/**
/resources/assets/vendor/fonts/fontawesome/**


# Generated frontend files
/public/css
/public/js
/public/mix-manifest.json


# ------------------------------------------------------------
# PUBLIC ASSETS EXCEPTIONS
# ------------------------------------------------------------

# Jika nanti ingin mengatur file tertentu di dalam public/assets:
#
# /public/assets/*
# !/public/assets/json
# /public/assets/json/*
# !/public/assets/json/search-vertical.json
# !/public/assets/json/search-horizontal.json


# ------------------------------------------------------------
# TEMPLATE CUSTOMIZER
# ------------------------------------------------------------

# Jangan abaikan file template-customizer.js
!/resources/assets/vendor/js/template-customizer.js


